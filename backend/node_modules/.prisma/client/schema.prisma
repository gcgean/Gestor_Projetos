generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  FINANCE
  READER
}

enum ProjectStatus {
  IDEA
  DEVELOPMENT
  MVP
  LAUNCHED
  SCALING
  PAUSED
  CLOSED
}

enum CategoryKind {
  REVENUE
  EXPENSE
}

model User {
  id               String     @id @default(cuid())
  name             String
  email            String     @unique
  passwordHash     String
  role             UserRole   @default(ADMIN)
  telegramBotToken String?
  telegramChatId   String?
  projects         Project[]
  categories       Category[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Category {
  id        String       @id @default(cuid())
  name      String
  kind      CategoryKind
  ownerId   String
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([ownerId, kind, name])
}

model Project {
  id                String        @id @default(cuid())
  name              String
  description       String?
  type              String
  status            ProjectStatus @default(IDEA)
  color             String        @default("#7c6cff")
  monthlyGoal       Decimal?      @db.Decimal(14, 2)
  yearlyGoal        Decimal?      @db.Decimal(14, 2)
  initialInvestment Decimal?      @db.Decimal(14, 2)
  startDate         DateTime?
  url               String?
  isOnline          Boolean?
  lastCheckedAt     DateTime?
  ownerId           String
  owner             User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  revenues          Revenue[]
  expenses          Expense[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([ownerId, status])
}

model Revenue {
  id          String    @id @default(cuid())
  projectId   String
  category    String
  description String?
  amount      Decimal   @db.Decimal(14, 2)
  competence  DateTime
  receivedAt  DateTime?
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([projectId, competence])
}

model Expense {
  id          String    @id @default(cuid())
  projectId   String
  category    String
  description String?
  amount      Decimal   @db.Decimal(14, 2)
  competence  DateTime
  dueDate     DateTime?
  paidAt      DateTime?
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([projectId, competence])
}
